{
    "name": "boldlinestudios/laravel-revenuecat-api",
    "description": "A package for Laravel backends to integrate with RevenueCat API v2 via typed methods and structured data objects.",
    "keywords": [
        "BoldLineStudios",
        "laravel",
        "revenuecat",
        "laravel-revenuecats-api",
        "sdk",
        "iap"
    ],
    "homepage": "https://github.com/boldlinestudios/laravel-revenuecat-api",
    "authors": [
        {
            "name": "Ken Gould",
            "email": "ken@boldlinestudios.com"
        }
    ],
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "BoldLineStudios\\RevenueCatApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
        "BoldLineStudios\\RevenueCatApi\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0 || ^12.0"
    },
    "require-dev": {
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.4",
        "pestphp/pest": "^3.8",
        "phpstan/phpstan": "^2.1"
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "optimize-autoloader": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "BoldLineStudios\\RevenueCatApi\\RevenueCatApiServiceProvider"
            ],
            "aliases": {
                "RevenueCat": "BoldLineStudios\\RevenueCatApi\\Facades\\RevenueCat"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "lint": "vendor/bin/pint -v",
        "stan": "vendor/bin/phpstan analyse --memory-limit=1G"
    }
}
