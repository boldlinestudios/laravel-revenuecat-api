{
    "name": "boldlinestudios/laravel-revenuecat-api",
    "version": "0.4.2",
    "description": "A Laravel wrapper for the RevenueCat API 2.0",
    "keywords": [
        "BoldLineStudios",
        "laravel",
        "revenuecat",
        "laravel-revenuecat-api"
    ],
    "homepage": "https://github.com/boldlinestudios/laravel-revenuecat-api",
    "authors": [
        {
            "name": "Ken Gould",
            "email": "ken@boldlinestudios.com"
        }
    ],
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "BoldlineStudios\\RevenueCatApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
        "BoldlineStudios\\RevenueCatApi\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0 || ^12.0"
    },
    "require-dev": {
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.4",
        "pestphp/pest": "^3.8",
        "phpstan/phpstan": "^2.1"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "optimize-autoloader": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "BoldlineStudios\\RevenueCatApi\\RevenueCatApiServiceProvider"
            ],
            "aliases": {
                "RevenueCat": "BoldlineStudios\\RevenueCatApi\\Facades\\RevenueCat"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
    }
}
